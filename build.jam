#
# webrtc, the W3C WebRTC data-channel API in Asio's model. A program uses
# /webcpp/webrtc//webrtc: natively it brings the pinned libdatachannel and its
# OpenSSL, which need threading=multi; on emscripten it brings nothing but
# webcpp::asio, whose usage requirements link its browser runtime (the
# bridge's export and JavaScript, <webcpp/asio/browser/src.hpp>), embind and
# the suspension variant's flag, so that a program includes nothing more.

project /webcpp/webrtc ;

import feature ;

# What a target cannot honour: an error by default, ignored where the platform
# does an equivalent thing of its own (design.md, D14). Propagated, so that a
# whole program agrees.
feature.feature webcpp-webrtc-unsupported : error ignore : propagated ;

# The headers, without a backend: what the platform-free tests use.
alias headers : : : : <include>include <library>/webcpp/config//config
  <library>/webcpp/asio//headers
  <webcpp-webrtc-unsupported>error:<define>WEBCPP_WEBRTC_UNSUPPORTED_ERROR
  <webcpp-webrtc-unsupported>ignore:<define>WEBCPP_WEBRTC_UNSUPPORTED_IGNORE ;

# Natively, libdatachannel through its C API, which works with exceptions on
# and off (design.md, D4): no <exception-handling> is required of a consumer.
# In the browser, the browser's own objects, through webcpp::asio's bridge,
# whose JavaScript catches the browser's exceptions (design.md, D8).
# tag::webrtc[]
alias webrtc : : <toolset>emscripten : : <library>headers <library>/webcpp/asio//asio ;
alias webrtc : : : : <library>headers <library>/webcpp/asio//asio
  <library>/webcpp/third_party//libdatachannel ;
# end::webrtc[]
