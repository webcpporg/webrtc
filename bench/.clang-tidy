# The benchmark inherits the superproject's configuration and switches off one
# option.
#
# bugprone-exception-escape.CheckMain treats the benchmark's main as a
# function that should not throw. Its main lets what a fault throws, a
# std::runtime_error naming what went wrong or one of libdatachannel's C++
# API, end the process uncaught, which fails the smoke pass and the
# measurement as it should. The check stays on for everything else: a
# noexcept function, a destructor, a move or a swap.
---
InheritParentConfig: true
CheckOptions:
  - key: bugprone-exception-escape.CheckMain
    value: 'false'
