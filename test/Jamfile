project : requirements <library>/webcpp/webrtc//headers ;

import feature ;
import webcpp ;

# Natively and on emscripten, both suspension variants (webcpp-suspend=jspi
# and asyncify on b2's command line); what needs libdatachannel names native
# alone, and what needs a browser's objects names emscripten alone.
webcpp.targets native emscripten ;

# Every header alone: the interface and the platform-free headers on both
# targets, natively against libdatachannel, whose threads need
# threading=multi there; each backend's headers on its own target. It works
# without exceptions: natively libdatachannel is called through its C API
# (design.md, D4), and in the browser JavaScript catches its own (D8).
rule native-threads ( properties * )
{
    if [ feature.get-values <toolset> : $(properties) ] != emscripten
    {
        return <threading>multi ;
    }
}
webcpp.headers-alone webrtc : ../include
  : webrtc.hpp webrtc/*.hpp webrtc/detail/*.hpp
  : <conditional>@native-threads : native emscripten ;
webcpp.headers-alone webrtc : ../include : webrtc/detail/native/*.hpp
  : <threading>multi : native ;
webcpp.headers-alone webrtc : ../include : webrtc/detail/browser/*.hpp
  : : emscripten ;

# config.hpp defines WEBCPP_WEBRTC_NO_EXCEPTIONS exactly when webcpp has no
# exceptions, and keeps it when a developer defines it in a build that has
# them.
webcpp.compile config : config_test.cpp ;
webcpp.compile config_developer_defined : config_test.cpp
  : <define>WEBCPP_WEBRTC_NO_EXCEPTIONS <define>WEBCPP_TEST_WEBRTC_DEVELOPER_DEFINED ;
webcpp.compile config_all_off : config_test.cpp
  : <define>WEBCPP_NO_EXCEPTIONS <define>WEBCPP_TEST_WEBRTC_ALL_OFF ;

# The platform-free parts: errors, value types, the event machinery, each as
# the build asks and without exceptions. The event machinery runs an
# io_context, which on emscripten is webcpp::asio's.
webcpp.run error : error_test.cpp ;
webcpp.run error_no_exceptions : error_test.cpp : <exception-handling>off ;
webcpp.run types : types_test.cpp ;
webcpp.run types_no_exceptions : types_test.cpp : <exception-handling>off ;
webcpp.run events : events_test.cpp : <library>/webcpp/asio//asio ;
webcpp.run events_no_exceptions : events_test.cpp
  : <library>/webcpp/asio//asio <exception-handling>off ;

# Two native peers over the loopback, as the build asks and without
# exceptions; libdatachannel's threads need threading=multi.
# tag::native[]
webcpp.run native : native_test.cpp : <library>/webcpp/webrtc//webrtc <threading>multi : native ;
webcpp.run native_no_exceptions : native_test.cpp
  : <library>/webcpp/webrtc//webrtc <threading>multi <exception-handling>off : native ;
# end::native[]

# What the native target cannot honour (design.md, D14): a channel's
# max_packet_life_time of 0 fails create_data_channel with
# operation_not_supported under the default policy, and is 0 retransmissions
# under webcpp-webrtc-unsupported=ignore (native_policy_ignore); each with
# exceptions and without.
webcpp.run native_policy : native_policy_test.cpp
  : <library>/webcpp/webrtc//webrtc <threading>multi : native ;
webcpp.run native_policy_no_exceptions : native_policy_test.cpp
  : <library>/webcpp/webrtc//webrtc <threading>multi <exception-handling>off : native ;
webcpp.run native_policy_ignore : native_policy_test.cpp
  : <library>/webcpp/webrtc//webrtc <threading>multi <webcpp-webrtc-unsupported>ignore
  : native ;
webcpp.run native_policy_ignore_no_exceptions : native_policy_test.cpp
  : <library>/webcpp/webrtc//webrtc <threading>multi <webcpp-webrtc-unsupported>ignore
    <exception-handling>off : native ;

# Allocation: the object's state, queues and outputs in its allocator, and
# nothing of it on libdatachannel's threads.
webcpp.run allocation : allocation_test.cpp
  : <library>/webcpp/webrtc//webrtc <threading>multi : native ;

# Destruction while libdatachannel's threads deliver events, and a flooded
# channel never read, then destroyed.
webcpp.run lifetime : lifetime_test.cpp
  : <library>/webcpp/webrtc//webrtc <threading>multi : native ;

# The measurement of tasks.md 1.10: a never-read channel past 1,024 messages
# and the connection's other channels.
webcpp.run stall : stall_test.cpp : <library>/webcpp/webrtc//webrtc <threading>multi : native ;

# The receive benchmark's smoke pass (bench/receive_bench.cpp): a few rounds
# of each path, each message checked, so that the lanes keep the measurement
# building and right. Its comparison uses libdatachannel's C++ API, which
# throws: it alone needs exceptions.
webcpp.run bench : ../bench/receive_bench.cpp
  : <define>WEBCPP_TEST_WEBRTC_BENCH_SMOKE <library>/webcpp/webrtc//webrtc <threading>multi
    <exception-handling>on : native ;

# The browser's tests under node, which has no WebRTC of its own, with the
# test's own objects in its place:
#
# - browser_imports: what each browser call reports when the object it
#   calls throws, and that none enters C++ during its call;
# - browser_runtime: the runtime's cap, and a slot the page's census frees
#   once the garbage collector frees its connection (node's gc, which the
#   test exposes);
# - browser_backend: the peer connection's and the data channel's semantics,
#   with a connection whose events the test fires; a real browser's
#   behaviour is test/browser's;
# - browser_policy: what the browser cannot honour (design.md, D14),
#   bind_address failing make under the default policy, and ignored under
#   webcpp-webrtc-unsupported=ignore (browser_policy_ignore).
#
# Each runs in the suspension variant b2 is asked for, and in asyncify
# whatever b2 is asked for (the _asyncify twins, as webcpp::asio's browser
# tests), so that a lane that asks for jspi alone runs both; each with
# exceptions and without.
local browser-tests = browser_imports browser_runtime browser_backend browser_policy ;
for local test in $(browser-tests)
{
    webcpp.run $(test) : $(test)_test.cpp : <library>/webcpp/webrtc//webrtc : emscripten ;
    webcpp.run $(test)_no_exceptions : $(test)_test.cpp
      : <library>/webcpp/webrtc//webrtc <exception-handling>off : emscripten ;
    webcpp.run $(test)_asyncify : $(test)_test.cpp
      : <library>/webcpp/webrtc//webrtc <webcpp-suspend>asyncify : emscripten ;
    webcpp.run $(test)_asyncify_no_exceptions : $(test)_test.cpp
      : <library>/webcpp/webrtc//webrtc <webcpp-suspend>asyncify <exception-handling>off
      : emscripten ;
}
for local suspend in "" _asyncify
{
    local variant = <webcpp-suspend>asyncify ;
    # The boundary holds on both targets; the asyncify twins are emscripten's.
    local boundary-targets = emscripten ;
    if ! $(suspend) { variant = ; boundary-targets = native emscripten ; }
    webcpp.run browser_policy_ignore$(suspend) : browser_policy_test.cpp
      : <library>/webcpp/webrtc//webrtc <webcpp-webrtc-unsupported>ignore $(variant)
      : emscripten ;
    webcpp.run browser_policy_ignore$(suspend)_no_exceptions : browser_policy_test.cpp
      : <library>/webcpp/webrtc//webrtc <webcpp-webrtc-unsupported>ignore $(variant)
        <exception-handling>off : emscripten ;

    # Translation units that disagree on the policy name different types, so
    # that a channel passed between them fails to link; the control, which
    # agrees, links and runs (webcpp::beast's D9 test).
    webcpp.run config_boundary$(suspend) : config_provider.cpp config_consumer.cpp
      : <library>/webcpp/webrtc//webrtc <conditional>@native-threads $(variant)
      : $(boundary-targets) ;
    webcpp.run config_boundary$(suspend)_no_exceptions : config_provider.cpp config_consumer.cpp
      : <library>/webcpp/webrtc//webrtc <conditional>@native-threads $(variant)
        <exception-handling>off : $(boundary-targets) ;
    webcpp.link-fail config_mismatch$(suspend) : config_provider.cpp config_consumer.cpp
      : <library>/webcpp/webrtc//webrtc <conditional>@native-threads
        <define>WEBCPP_TEST_WEBRTC_MISMATCH $(variant) : $(boundary-targets) ;
}

# The browser lane: two peers in one page of headless Chrome, both suspension
# variants, with exceptions on and off (test/browser/Jamfile).
build-project browser ;

# The interop lane: a native peer and a peer in headless Chrome, signalled
# through a local relay over webcpp::beast's WebSocket (test/interop/Jamfile).
build-project interop ;
